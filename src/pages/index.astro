---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="fog-container">
    <div class="fog fog-1"></div>
    <div class="fog fog-2"></div>
    <div class="fog fog-3"></div>
  </div>
  <!-- Hero Section -->
  <section>
    <div class="content">
      <div class="hero">
        <h1>VAPOR<br />NIGHTS</h1>
        <p class="tagline">Halloween Edition</p>
      </div>
    </div>
  </section>

  <!-- Date Section -->
  <section>
    <div class="content">
      <div class="detail-section">
        <h2>When</h2>
        <div class="detail-value">[Date]</div>
        <div class="detail-label">October 2025</div>
      </div>
    </div>
  </section>

  <!-- Time Section -->
  <section>
    <div class="content">
      <div class="detail-section">
        <h2>Time</h2>
        <div class="detail-value">[Time]</div>
        <div class="detail-label">Doors Open</div>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section>
    <div class="content">
      <div class="detail-section">
        <h2>Where</h2>
        <div class="detail-value">[Venue]</div>
        <div class="detail-label">Location TBD</div>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <section>
    <div class="content">
      <div class="products-section">
        <h2>Devices</h2>
        <div class="product-grid">
          <div class="product-card">
            <h3>[Brand] Pro</h3>
            <p>
              Premium performance. Advanced temperature control. Extended
              battery life.
            </p>
          </div>
          <div class="product-card">
            <h3>[Brand] Mini</h3>
            <p>Compact design. Powerful vapor. Pocket-friendly portability.</p>
          </div>
          <div class="product-card">
            <h3>[Brand] X</h3>
            <p>
              Limited edition. Halloween exclusive. Cutting-edge technology.
            </p>
          </div>
        </div>
        <div class="cta">
          <a
            href="#"
            class="cta-button"
            >Shop Now</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section>
    <div class="content">
      <div class="detail-section">
        <h2>Get in Touch</h2>
        <div
          class="detail-label"
          style="margin-bottom: 3rem;"
        >
          Questions? Want to RSVP? Chat with us.
        </div>
        <a
          href="https://wa.me/[PHONE_NUMBER]"
          class="whatsapp-button"
          target="_blank"
          rel="noopener"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path>
          </svg>
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <!-- Footer Section -->
  <section>
    <div class="content">
      <div class="footer-section">
        <p>
          WARNING: This product contains nicotine.<br />Nicotine is an addictive
          chemical.<br /><br />For adult use only (21+).<br />Keep out of reach
          of children and pets.
        </p>
      </div>
    </div>
  </section>
</Layout>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-snap-type: y mandatory;
    timeline-scope: --section;
  }

  /* Section snapping */
  section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
    view-timeline: --section;
    height: 100dvh;
    position: relative;
  }

  .content {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    animation: blink ease-in-out both;
    animation-timeline: --section;
    z-index: 2;
  }

  @keyframes blink {
    0%,
    100% {
      filter: blur(1rem) contrast(4);
      opacity: 0;
      visibility: hidden;
    }
    50% {
      filter: blur(0) contrast(1);
      opacity: 1;
      visibility: visible;
    }
  }

  .hero {
    text-align: center;
    max-width: 900px;
    padding: 2rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 200;
    letter-spacing: 0.5em;
    margin-bottom: 2rem;
    background: linear-gradient(90deg, #ff6b35, #8a2be2, #ff6b35);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient 8s ease infinite;
  }

  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .hero .tagline {
    font-size: clamp(1rem, 3vw, 1.5rem);
    font-weight: 300;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }

  .detail-section {
    text-align: center;
    max-width: 600px;
    padding: 2rem;
  }

  .detail-section h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.2em;
    margin-bottom: 3rem;
    color: #ff6b35;
    text-transform: uppercase;
  }

  .detail-value {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 200;
    letter-spacing: 0.1em;
    color: #fff;
    margin-bottom: 1rem;
  }

  .detail-label {
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    font-weight: 300;
    letter-spacing: 0.3em;
    color: rgba(138, 43, 226, 0.8);
    text-transform: uppercase;
  }

  .products-section {
    max-width: 1000px;
    padding: 2rem;
    text-align: center;
  }

  .products-section h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.2em;
    margin-bottom: 4rem;
    color: #ff6b35;
    text-transform: uppercase;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
  }

  .product-card {
    padding: 3rem 2rem;
    border: 1px solid rgba(138, 43, 226, 0.3);
    transition: all 0.4s ease;
    border-radius: 10px;
  }

  .product-card:hover {
    border-color: #ff6b35;
    transform: translateY(-10px);
    box-shadow: 0 20px 60px rgba(255, 107, 53, 0.3);
  }

  .product-card h3 {
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .product-card p {
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.05em;
  }

  .cta {
    margin-top: 4rem;
  }

  .cta-button {
    display: inline-block;
    padding: 1.2rem 3rem;
    border: 1px solid #ff6b35;
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    transition: all 0.4s ease;
    background: transparent;
  }

  .cta-button:hover {
    background: #ff6b35;
    color: #000;
    box-shadow: 0 10px 40px rgba(255, 107, 53, 0.5);
  }

  .whatsapp-button {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.2rem 3rem;
    border: 1px solid #25d366;
    color: #25d366;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: all 0.4s ease;
    background: transparent;
  }

  .whatsapp-button:hover {
    background: #25d366;
    color: #000;
    box-shadow: 0 10px 40px rgba(37, 211, 102, 0.5);
  }

  .whatsapp-button svg {
    width: 24px;
    height: 24px;
  }

  .footer-section {
    text-align: center;
    padding: 2rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.1em;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Fog effect */
  .fog-container {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .fog {
    position: absolute;
    height: 100%;
    width: 300%;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><defs><filter id="blur"><feGaussianBlur in="SourceGraphic" stdDeviation="20"/></filter></defs><circle cx="200" cy="300" r="150" fill="rgba(138,43,226,0.3)" filter="url(%23blur)"/><circle cx="600" cy="500" r="200" fill="rgba(255,107,53,0.25)" filter="url(%23blur)"/><circle cx="900" cy="200" r="180" fill="rgba(138,43,226,0.2)" filter="url(%23blur)"/></svg>');
    background-repeat: repeat-x;
    background-size: 1000px 100%;
    filter: blur(40px);
    opacity: 0.8;
  }

  .fog-1 {
    animation: fogMove1 30s linear infinite;
    top: 0;
  }

  .fog-2 {
    animation: fogMove2 35s linear infinite;
    top: 20%;
    animation-delay: -10s;
  }

  .fog-3 {
    animation: fogMove3 40s linear infinite;
    top: 40%;
    animation-delay: -20s;
  }

  @keyframes fogMove1 {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }

  @keyframes fogMove2 {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }

  @keyframes fogMove3 {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #000;
    color: #fff;
    overflow-x: hidden;
  }
  @media (max-width: 768px) {
    html {
      scroll-snap-type: none;
    }

    section {
      height: auto;
      min-height: 100dvh;
      scroll-snap-align: none;
    }

    .content {
      position: relative;
      animation: none;
      filter: none !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    .fog {
      background-size: 500px 100%;
      filter: blur(30px);
    }

    .hero {
      padding: 3rem 1.5rem;
    }

    .hero h1 {
      font-size: 3rem;
      letter-spacing: 0.2em;
      line-height: 1.2;
    }

    .hero .tagline {
      font-size: 1rem;
      letter-spacing: 0.15em;
    }

    .detail-section {
      padding: 2rem 1.5rem;
    }

    .detail-section h2,
    .products-section h2 {
      font-size: 2rem;
      letter-spacing: 0.1em;
      margin-bottom: 2rem;
    }

    .detail-value {
      font-size: 2.5rem;
      letter-spacing: 0.05em;
    }

    .detail-label {
      font-size: 0.9rem;
      letter-spacing: 0.1em;
    }

    .products-section {
      padding: 2rem 1.5rem;
    }

    .product-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product-card {
      padding: 2rem 1.5rem;
    }

    .product-card h3 {
      font-size: 1.3rem;
      letter-spacing: 0.1em;
    }

    .cta-button,
    .whatsapp-button {
      padding: 1rem 2rem;
      font-size: 0.9rem;
      letter-spacing: 0.15em;
    }

    .footer-section {
      padding: 2rem 1.5rem;
      font-size: 0.75rem;
    }
  }
</style>
